{
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(cargo:*)",
      "Bash(just:*)",
      "Bash(fd:*)",
      "Bash(find:*)",
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(grep:*)",
      "Bash(mise:*)",
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(rg:*)",
      "Bash(sd:*)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "Bash(sed:*)",
      "mcp__codegraph__codegraph_search",
      "mcp__codegraph__codegraph_context",
      "mcp__codegraph__codegraph_callers",
      "mcp__codegraph__codegraph_callees",
      "mcp__codegraph__codegraph_impact",
      "mcp__codegraph__codegraph_node",
      "mcp__codegraph__codegraph_status"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/tylerbu/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "curl -sS --connect-timeout 2 --max-time 5 -H 'Content-Type: application/json' --data-binary @- \"http://127.0.0.1:7823/hook${CONSTELLATION_TERMINAL_ID:+?terminal_id=$CONSTELLATION_TERMINAL_ID}\" >/dev/null 2>&1 || true"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7823/hook",
            "timeout": 10
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7823/hook",
            "timeout": 10
          }
        ],
        "matcher": "*"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7823/hook",
            "timeout": 10
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7823/hook",
            "timeout": 10
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7823/hook",
            "timeout": 10
          }
        ],
        "matcher": "*"
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7823/hook",
            "timeout": 600
          }
        ],
        "matcher": "*"
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7823/hook",
            "timeout": 10
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7823/hook",
            "timeout": 10
          }
        ],
        "matcher": "*"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7823/hook",
            "timeout": 10
          }
        ],
        "matcher": "*"
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7823/hook",
            "timeout": 10
          }
        ],
        "matcher": "*"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7823/hook",
            "timeout": 10
          }
        ],
        "matcher": "*"
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7823/hook",
            "timeout": 10
          }
        ],
        "matcher": "*"
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7823/hook",
            "timeout": 10
          }
        ],
        "matcher": "*"
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7823/hook",
            "timeout": 10
          }
        ],
        "matcher": "*"
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7823/hook",
            "timeout": 10
          }
        ],
        "matcher": "*"
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7823/hook",
            "timeout": 10
          }
        ],
        "matcher": "*"
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7823/hook",
            "timeout": 10
          }
        ],
        "matcher": "*"
      }
    ],
    "Elicitation": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7823/hook",
            "timeout": 600
          }
        ],
        "matcher": "*"
      }
    ],
    "ElicitationResult": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7823/hook",
            "timeout": 10
          }
        ],
        "matcher": "*"
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7823/hook",
            "timeout": 10
          }
        ],
        "matcher": "*"
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7823/hook",
            "timeout": 10
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "forceLoginMethod": "console",
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "skipAutoPermissionPrompt": true
}